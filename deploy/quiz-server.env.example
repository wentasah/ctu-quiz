# Environment file for quiz-server.service; keep it mode 0600, it holds the
# OIDC client secret. Every option of `quiz-server --help` has an equivalent
# here.

# Only the reverse proxy talks to the server directly.
QUIZ_LISTEN=127.0.0.1:8080

# How students reach it. Must match the reverse proxy and the redirect URI
# registered with the OIDC provider.
QUIZ_PUBLIC_URL=https://quiz.iid.ciirc.cvut.cz

# OIDC provider and the client registered for this application.
QUIZ_OIDC_ISSUER=https://idp.example.org/realms/fel
QUIZ_OIDC_CLIENT_ID=quiz
QUIZ_OIDC_CLIENT_SECRET=change-me

# Logins, and roles in the `roles` claim of the access token, that may ask
# questions. The server refuses to start without either; set
# QUIZ_ALLOW_ANY_TEACHER=true to let everybody who can log in ask.
QUIZ_TEACHERS=sojkam1
#QUIZ_TEACHER_ROLES=teacher
#QUIZ_ROLES_CLAIM=roles

# The reverse proxy sets X-Forwarded-For, so client addresses may be logged.
QUIZ_TRUST_PROXY=true

# Language of the web pages for browsers that ask for neither English nor
# Czech.
#QUIZ_DEFAULT_LANG=cs

# Uncomment if the teacher CLI is registered as a separate public client.
#QUIZ_OIDC_CLI_CLIENT_ID=quiz-cli
#QUIZ_OIDC_CLI_REDIRECT_URI=http://127.0.0.1:28191/callback

#RUST_LOG=info,quiz_server=debug
